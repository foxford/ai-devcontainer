{
  // Тонкий devcontainer: тулчейн и скрипты — в образе dev-base (репо ai-devcontainer).
  // Проектное здесь: имя, маунты соседних репо, расширения.
  "name": "MyProject",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "PROJECT_NAME": "MyProject"
    }
  },

  // Выполняется на ХОСТЕ до сборки и маунтов: создаёт персист-каталоги ЭТОГО
  // проекта (~/.ai-devcontainer-dev/MyProject/*), дособирает dev-base:local и сверяет
  // этот файл с платформенным чек-листом. Требует установленной платформы:
  // curl -fsSL https://raw.githubusercontent.com/foxford/ai-devcontainer/main/install.sh | bash
  //
  // Строка намеренно НЕИЗМЕНЯЕМАЯ: всё, что делает подготовка, живёт в CLI
  // платформы и обновляется через `adc update`. Раздать в проекты сам
  // devcontainer.json нельзя (VS Code нужен настоящий файл, и он законно
  // проектный), поэтому платформенную часть свели к одному вызову — теперь она
  // меняется централизованно, не трогая проекты. Подробнее и про то, почему это
  // не devcontainer Feature: docs/devcontainer-delivery.md в репо платформы.
  //
  // Дубль — не опечатка: VS Code запускает initializeCommand не из login-шелла,
  // и ~/.local/bin в PATH может не оказаться. prepare идемпотентен.
  "initializeCommand": "adc prepare || \"$HOME/.local/bin/adc\" prepare",

  // Единственная фича: docker-in-docker (в плоском Dockerfile её аккуратно
  // не воспроизвести).
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // host.docker.internal: Docker Desktop (macOS/WSL2) даёт его сам, на голом
  // Docker Engine (Linux) — только с этим флагом. Нужен опциональному MCP
  // серверу obsidian (см. README.md, раздел «Obsidian»): контейнер достаёт до
  // плагина Local REST API на хосте, если тот у разработчика поднят.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],

  // Юзер зафиксирован в образе — маунты идут прямо в /home/node/*.
  // Каталоги-цели предсозданы node:node в dev-base (иначе Docker создаст
  // недостающих родителей от root → EACCES).
  "remoteUser": "node",
  "containerUser": "node",

  "mounts": [
    // Клон платформы (read-only): post-create, helpers, seed-шаблоны скиллов.
    // Правка скриптов/скиллов в платформе видна сразу — без пересборки образа.
    // В образ запечён только tooling/setup.sh (нужен на этапе build).
    "source=${localEnv:HOME}/.local/share/ai-devcontainer,target=/opt/ai-devcontainer,type=bind,readonly",

    // Vault Obsidian — персист, чтобы хостовый Obsidian открывал те же файлы,
    // что пишет graphify (--obsidian --obsidian-dir /home/node/obsidian-vault).
    // Чисто файловая штука: живому Obsidian сокет для этого не нужен вовсе.
    "source=${localEnv:HOME}/.ai-devcontainer-dev/MyProject/obsidian,target=/home/node/obsidian-vault,type=bind,consistency=cached",

    // Персист AI-тулзов и истории — PER-PROJECT (~/.ai-devcontainer-dev/MyProject/*):
    // у каждого проекта свои логины/сессии/история — параллельно открытые
    // контейнеры не дерутся за ~/.claude и hermes-конфиги. Каталоги создаёт
    // initializeCommand (на хосте, до маунтов).
    "source=${localEnv:HOME}/.ai-devcontainer-dev/MyProject/claude,target=/home/node/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ai-devcontainer-dev/MyProject/opencode,target=/home/node/.config/opencode,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ai-devcontainer-dev/MyProject/codex,target=/home/node/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ai-devcontainer-dev/MyProject/hermes,target=/home/node/.hermes,type=bind,consistency=cached",
    // DSH (DeepSeek Harness): профили, сессии, ~/.dsh/.env с DEEPSEEK_API_KEY
    // и cordis.patch.yml с MCP-серверами — всё в home, проектного скоупа у
    // dsh нет вовсе. Пер-проектный маунт и есть тот скоуп.
    "source=${localEnv:HOME}/.ai-devcontainer-dev/MyProject/dsh,target=/home/node/.dsh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ai-devcontainer-dev/MyProject/uv,target=/home/node/.local/share/uv,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ai-devcontainer-dev/MyProject/history,target=/home/node/.history,type=bind,consistency=cached",
    // Named volumes — переживают rebuild
    "source=platform-ai-tools,target=/opt/ai-tools,type=volume",
    "source=platform-pnpm-store,target=/home/node/.pnpm-store,type=volume",
    // Бинарь Claude Code (324 МБ). В /opt/ai-tools лежит только ЛАУНЧЕР, а сам
    // бинарь — здесь, в ~/.local/share/claude/versions/. Без этого volume он
    // контейнер-локальный: каждый rebuild лаунчер оказывается битым и
    // install-ai-tools качает 324 МБ заново.
    "source=platform-claude-versions,target=/home/node/.local/share/claude,type=volume",
    // Браузеры Playwright. В образ не печём: их ревизия привязана к версии
    // пакета в ПРОЕКТЕ, а образ dev-base общий — прибитый в него chromium
    // разъехался бы с package.json. Volume общий на все проекты (как pnpm-store):
    // ревизии лежат рядом по версиям, повторно ничего не качается.
    // Ставит post-create; путь задан в образе ($PLAYWRIGHT_BROWSERS_PATH).
    "source=platform-playwright-browsers,target=/home/node/.cache/ms-playwright,type=volume"
    // Соседние проекты — добавляй по надобности:
    // "source=${localEnv:HOME}/Development/@foxford/<repo>,target=/workspaces/<repo>,type=bind,consistency=cached"
  ],

  "postCreateCommand": "bash /opt/ai-devcontainer/tooling/post-create-setup.sh",

  "customizations": {
    "vscode": {
      "settings": {
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/node_modules/**": true,
          "**/tmp/**": true,
          "**/build/**": true,
          "**/bower_components/**": true,
          "**/dist/**": true,
          "**/graphify-out/**": true,
          "**/.nx/**": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/bower_components": true,
          "**/*.code-search": true,
          "**/graphify-out/**": true,
          "**/dist/**": true,
          "**/build/**": true,
          "**/tmp/**": true,
          "**/cache/**": true,
          "**/.nx/**": true
        },
        "editor.cursorWidth": 2,
        "editor.tabSize": 2,
        "debug.javascript.autoAttachFilter": "disabled",
        "terminal.integrated.scrollback": 5000,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "always",
          "source.fixAll.eslint": "always"
        },
        "[typescript]": {
          "editor.defaultFormatter": "dbaeumer.vscode-eslint"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "dbaeumer.vscode-eslint"
        }
      },
      "extensions": [
        "vscode-icons-team.vscode-icons",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "anthropic.claude-code",
        "vitest.explorer",
        "ms-playwright.playwright",
        "eamodio.gitlens",
        "mikestead.dotenv",
        "christian-kohler.path-intellisense",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid",
        "sst-dev.opencode",
        "openai.chatgpt",
        "mhutchie.git-graph",
        "Gruntfuggly.todo-tree",
        "johnpapa.vscode-peacock",
        "pomber.git-file-history",
        "alberto-varela.monorepo-focus-workspace",
        "xabikos.JavaScriptSnippets",
        "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
        "MermaidChart.vscode-mermaid-chart",
        "vstirbu.vscode-mermaid-preview",
        "SimonSiefke.svg-preview",
        "alexdima.copy-relative-path",
        "davidfreer.go-to-character-position",
        "ecmel.vscode-html-css",
        "george-alisson.html-preview-vscode",
        "lokalise.i18n-ally",
        "wix.vscode-import-cost",
        "leizongmin.node-module-intellisense",
        "redhat.vscode-xml",
        "unifiedjs.vscode-mdx",
        "xyc.vscode-mdx-preview",
        "AykutSarac.jsoncrack-vscode"
      ]
    }
  }
}
