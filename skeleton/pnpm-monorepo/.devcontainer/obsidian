#!/usr/bin/env python3
import socket, json, sys, struct, os

SOCKET = "/run/obsidian.sock"

def send_msg(s, data: bytes):
    s.sendall(struct.pack(">I", len(data)) + data)

def recv_msg(s) -> bytes:
    raw = s.recv(4)
    length = struct.unpack(">I", raw)[0]
    return s.recv(length)

if not os.path.exists(SOCKET):
    sys.stderr.write(f"ERROR: obsidian socket not found at {SOCKET}\n")
    sys.exit(1)

stdin_data = "" if sys.stdin.isatty() else sys.stdin.read()

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(SOCKET)

send_msg(s, json.dumps({
    "args":  sys.argv[1:],
    "stdin": stdin_data
}).encode())

result = json.loads(recv_msg(s).decode())
s.close()

sys.stdout.write(result["stdout"])
sys.stderr.write(result["stderr"])
sys.exit(result["returncode"])
