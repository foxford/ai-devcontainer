{
  "name": "my-project",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test --passWithNoTests",
    "lint": "nx run-many -t lint:eslint",
    "type-check": "nx run-many -t lint:type-check",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "e2e:type-check": "tsc --noEmit -p e2e",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "clean:cache": "nx reset"
  },
  "packageManager": "pnpm@10.25.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "catalog:dev",
    "@foxford/automation": "workspace:*",
    "@foxford/eslint-config": "workspace:*",
    "@foxford/prettier-config": "workspace:*",
    "@foxford/typescript-config": "workspace:*",
    "@foxford/vitest-config": "workspace:*",
    "nx": "^23.1.2",
    "prettier": "^3.9.6",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "@types/node": "catalog:dev"
  },
  "pnpm": {
    "requiredScripts": [
      "build",
      "test",
      "lint:eslint",
      "lint:type-check"
    ]
  }
}
