__pycache__/
*.py[cod]

.vscode/settings.json


# ai-devcontainer specific
.nx/
graphify-out/
.claude/
.eslintcache
.pnpm-store/

# Индекс скиллов — генерируется tooling/wire-agent-skills.sh из двух слоёв
# (платформа + .agents/skills). Зависит от версии платформы, потому не в гите.
AGENTS.skills.md


# DSH (DeepSeek Harness): роут скиллов ранга 100 — симлинки на собранное
# дерево .claude/skills, раздаёт tooling/wire-agent-skills.sh. Генерируемое.
/.dsh/

# Доки платформы — раздаются симлинками (tooling/wire-docs.sh)
/AGENTS.platform.md
/MONOREPO.md
/.agents/skills/README.md
/plans/README.md
/.agents/mcp.secrets.env.example
